# Copy to backend/.env and fill in. Read by pipeline/llm.py.
LLM_PROVIDER=openai                 # openai | gemini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_ROUTER_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=low         # none | low | medium | high
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
BIDAYAH_EMBEDDER=bge-m3
BIDAYAH_RERANK=1                    # 0 = hybrid search only
# BIDAYAH_CORS=https://your-frontend.example   # allowed origins when the API is called cross-origin
