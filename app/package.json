{
  "name": "islamathon-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "tts:english-index": "node scripts/audio/build-index.mjs --locale en",
    "tts:test": "node --test scripts/audio/lib/narration.checks.mjs",
    "tts:arabic-index": "node scripts/audio/build-index.mjs --locale ar",
    "tts:plan:english": "node scripts/audio/generate-azure.mjs",
    "tts:generate:english": "node scripts/audio/generate-azure.mjs --generate --locale en --keep-completed",
    "tts:plan:arabic": "node scripts/audio/generate-eid.mjs",
    "tts:generate:arabic": "node scripts/audio/generate-eid.mjs --generate"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "@types/topojson-client": "^3.1.5",
    "@vercel/speed-insights": "^2.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "^29.1.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vitest": "^5.0.3"
  }
}
