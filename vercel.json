{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --prefix app",
  "buildCommand": "npm run build --prefix app",
  "outputDirectory": "app/dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/audio/narration/(en|ar)/(.*)",
      "headers": [{"key":"Cache-Control","value":"public, max-age=31536000, immutable"}]
    },
    {
      "source": "/audio/narration/(english|arabic)-index.json",
      "headers": [{"key":"Cache-Control","value":"public, max-age=0, must-revalidate"}]
    },
    {
      "source": "/audio/narration/summary-(english|arabic)-index.json",
      "headers": [{"key":"Cache-Control","value":"public, max-age=0, must-revalidate"}]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(fonts|images|map|sounds)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
